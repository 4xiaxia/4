# This file serves as a template for the required environment variables.
# Copy this file to .env.local and fill in the actual values.

# --- Backend API ---
# The base URL for the local backend server
VITE_API_BASE_URL="http://localhost:3001/api"

# --- Third-party AI Services ---

# 硅基流动 (SiliconFlow) - for text generation
VITE_SILICONFLOW_API_URL="https://api.siliconflow.cn"
VITE_SILICONFLOW_API_KEY=""
VITE_SILICONFLOW_MODEL="Qwen/Qwen3-8B"

# 智谱AI (BigModel) - for text generation and Speech-to-Text (STT)
VITE_BIGMODEL_API_URL="https://open.bigmodel.cn/api/paas/v4/"
VITE_BIGMODEL_API_KEY_1=""
VITE_BIGMODEL_API_KEY_2=""
VITE_BIGMODEL_MODEL="glm-4.5-flash"

# Minimax - for Text-to-Speech (TTS)
VITE_MINIMAX_GROUP_ID=""
VITE_MINIMAX_API_KEY=""

# --- Webhooks for Monitoring ---
VITE_WEBHOOK_1=""
VITE_WEBHOOK_2_TEMPLATE="https://api.day.app/your-key/{{时间-日期}}-{{API服务商-型号-异常}}"

# --- Mapping Service ---

# 高德地图 (Amap)
VITE_AMAP_KEY=""

# --- Backend as a Service (BaaS) ---

# Supabase - for database and backend services
VITE_SUPABASE_URL=""
VITE_SUPABASE_KEY=""
